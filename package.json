{
  "name": "tinywebui",
  "version": "0.2.0",
  "description": "A small, local-first chat workspace for any OpenAI-compatible model, with MCP tools.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TinySuiteHQ/TinyWebUI.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tinywebui": "bin/tinywebui.js"
  },
  "main": "server/server.js",
  "files": [
    "bin",
    "server",
    "shared",
    "dist",
    "README.md",
    "!**/*.ts"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "warn"
    }
  },
  "scripts": {
    "prestart": "npm run build:web && node bin/tinywebui.ts models ensure",
    "start": "node bin/tinywebui.ts",
    "predev": "node bin/tinywebui.ts models ensure",
    "dev": "node --watch-path=./server --watch-path=./bin --watch-path=./shared bin/tinywebui.ts",
    "dev:web": "vite web",
    "stop": "pkill -f 'bin/tinywebui' || true",
    "typecheck": "tsc -p . && node web/typecheck.mjs -p web",
    "test": "npm run typecheck && node --test --test-timeout=120000",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "vite build web",
    "clean": "tsc -b --clean tsconfig.build.json",
    "prepack": "npm run build",
    "eval": "node evals/run.js",
    "test:layout": "node layout/run.js"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cron-parser": "^5.10.1",
    "heic-convert": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1"
  },
  "license": "AGPL-3.0-or-later",
  "optionalDependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.20.5",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "6.0.11",
    "marked": "18.2.0",
    "pinia": "4.1.0",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  }
}
