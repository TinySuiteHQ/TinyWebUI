node_modules/
.env
.env.*
!.env.example

# Local deployment config, and the keys kept out of it -- local only.
tinywebui.config.json
tinywebui.secrets.json
tinywebui.config.js
tinywebui.config.mjs

# Local MCP wiring (paths, tokens), and the local servers' data (their
# embedding models, per-person databases). Anchored to the root, like
# /models/ below: a bare "mcp/" would also hide web/src/panels/mcp/.
mcp.json
/mcp/

# Conversation store (holds every tool result in full).
tinywebui.db
tinywebui.db-wal
tinywebui.db-shm
*.db
*.db-*

# Eval run records (evals/run.js).
evals/results/

# Embedding bundles (tinywebui models pull): large, fetched per deployment.
# Anchored: a bare "models/" also matched web/src/panels/models/ and kept
# ModelsPanel.vue out of git.
/models/
.playwright-mcp/

# Local agent notes.
CLAUDE.md

# Emitted beside the .ts sources by `npm run build`, for the npm package only
# (`npm run clean` removes them).
server/**/*.js
bin/*.js
shared/*.js

# The built page (`npm run build:web`): shipped in the npm package, never committed.
dist/
