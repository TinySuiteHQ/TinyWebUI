{
  // `npm run build`: the npm package only. Node will not strip types under
  // node_modules, so the tarball ships JS, emitted beside each .ts so every
  // relative path (../dist, ../shared, ../package.json) still holds. Checking
  // is `npm run typecheck`'s job.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noCheck": true,
    "allowJs": false,
    "rootDir": ".",
    "outDir": "."
  },
  "include": ["server/**/*.ts", "bin/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules"]
}
